msgid "Lightweight, professional gallery plugin — Grid, Masonry, Lightbox, filtering and lazy loading. No bloat, no dependencies."
msgstr "Letisztult, gyors, professzionális galéria plugin — Rács, Masonry, Lightbox, szűrés és lazy loading. Nulla függőség."

msgid "Getting started"
msgstr "Kezdő lépések"

msgid "Create a new gallery under <a href=\"%s\">Clean Gallery → Add New</a>."
msgstr "Hozz létre új galériát: <a href=\"%s\">Clean Gallery → Új hozzáadása</a>."

msgid "Pick images from the Media Library, set layout and columns, then publish."
msgstr "Válassz képeket a Média könyvtárból, állítsd be az elrendezést és oszlopokat, majd publikáld."

msgid "Embed it with the <code>[clean_gallery id=\"X\"]</code> shortcode or the <strong>Qaiyo Clean Gallery</strong> Gutenberg block."
msgstr "Ágyazd be a <code>[clean_gallery id=\"X\"]</code> shortcode-dal vagy a <strong>Qaiyo Clean Gallery</strong> Gutenberg blokkal."

msgid "Shortcodes"
msgstr "Shortcode-ok"

msgid "single gallery view"
msgstr "egy galéria megjelenítése"

msgid "all galleries grid with paging, sorting and category filter"
msgstr "összes galéria kártyás listája lapozással, rendezéssel és kategória szűrővel"

msgid "HappyFiles integration"
msgstr "HappyFiles integráció"

msgid "ACTIVE"
msgstr "AKTÍV"

msgid "NOT DETECTED"
msgstr "NEM ÉSZLELVE"

msgid "HappyFiles is active. On the gallery editor screen you can pick a HappyFiles folder and bulk-import all its images."
msgstr "A HappyFiles aktív. A galéria szerkesztőben kiválaszthatsz egy HappyFiles mappát, és tömegesen importálhatod az összes képét."

msgid "Install HappyFiles (free or Pro) to enable bulk-importing entire media folders into a gallery."
msgstr "Telepítsd a HappyFilest (ingyenes vagy Pro), hogy tömegesen importálhass teljes mappákat a galériába."

msgid "Qaiyo Clean Gallery v%s — by Qaiyo by PixelDesigns · qaiyo-plugins.com"
msgstr "Qaiyo Clean Gallery v%s — Készítette: Qaiyo by PixelDesigns · qaiyo-plugins.com"

msgid "Column switcher icon colors"
msgstr "Oszlopváltó ikon színek"

msgid "These colors are used for the 3-/4-column switcher icons on the [clean_gallery_all] view."
msgstr "Ezek a színek vonatkoznak a [clean_gallery_all] nézet 3 / 4 oszlop kapcsoló ikonjaira."

