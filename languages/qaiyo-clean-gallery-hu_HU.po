msgstr "— Nincs (kézi galéria) —"

msgid "Select a folder to live-link this gallery. Images stay in sync with HappyFiles automatically — no import needed."
msgstr "Válassz mappát az élő összekötéshez. A képek automatikusan szinkronban maradnak a HappyFilesszal — nincs szükség importra."

msgid "Live-linked to HappyFiles folder %1$s (%2$d image(s)). Add or remove images directly in HappyFiles — this gallery updates automatically."
msgstr "Élő kapcsolat a %1$s HappyFiles mappával (%2$d kép). Adj hozzá vagy törölj képeket közvetlenül a HappyFilesban — ez a galéria automatikusan frissül."

msgid "Standard (uniform squares)"
msgstr "Standard (egyforma négyzetek)"

msgid "Justified (equal-height rows)"
msgstr "Justified (egyenlő magas sorok)"

msgid "Bento (asymmetric)"
msgstr "Bento (aszimmetrikus)"

msgid "Lightbox & Protection"
msgstr "Lightbox és védelem"

msgid "Deep linking"
msgstr "Deep linking"

msgid "Add #hash to the URL when navigating the lightbox, so individual images can be linked and shared directly."
msgstr "#hash hozzáadása az URL-hez a lightbox navigálásakor, így az egyes képek közvetlenül linkelhetők és megoszthatók."

msgid "Social share buttons"
msgstr "Közösségi megosztó gombok"

msgid "Show Facebook, X, Pinterest and copy-link buttons inside the lightbox."
msgstr "Facebook, X, Pinterest és link másolás gombok megjelenítése a lightboxban."

msgid "Right-click protection"
msgstr "Jobb klikk védelem"

msgid "Disable right-click and drag on gallery images. Prevents casual downloading (not bulletproof)."
msgstr "Jobb klikk és húzás tiltása a galéria képein. Megakadályozza az egyszerű letöltést (nem teljesen áthatolhatatlan)."

msgid "Copy link"
msgstr "Link másolása"

